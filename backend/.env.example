APP_NAME="Nova Sync Systems"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL pública del backend (Laravel).
APP_URL=http://localhost:8000
# URL pública del frontend (React). Destino tras iniciar o rechazar la sesión.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos (recomendado: PostgreSQL 15+)
# Para una prueba local rápida puedes usar SQLite:
#   DB_CONNECTION=sqlite   (y crea el archivo database/database.sqlite)
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nova_soft_systems
# DB_USERNAME=nova
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sesión (cookie HttpOnly emitida por Laravel; el navegador no guarda tokens)
# En producción: SESSION_SECURE_COOKIE=true y HTTPS obligatorio.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Dominios (host:puerto) desde los que se sirve el frontend.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Proxies de confianza (balanceador/proxy inverso). Ej.: 10.0.0.0/8 o *
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Microsoft 365 / Microsoft Entra ID (OpenID Connect)
# Consulta docs/entra-id-setup.md. Nunca subas estos valores al repositorio.
# ---------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con el Redirect URI registrado en Entra ID.
# Con el proxy de Vite en desarrollo: http://localhost:5173/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
MICROSOFT_AUTHORITY=https://login.microsoftonline.com
MICROSOFT_JWKS_CACHE_TTL=21600
MICROSOFT_CLOCK_LEEWAY=120

# ---------------------------------------------------------------------------
# Acceso al ERP
# ---------------------------------------------------------------------------
# false (recomendado): solo ingresan cuentas autorizadas previamente.
NOVA_AUTO_PROVISION_USERS=false
# Dominios de correo permitidos, separados por coma (vacío = cualquiera del tenant).
NOVA_ALLOWED_EMAIL_DOMAINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
