# Variables para docker compose. Copia este archivo como .env en esta misma
# carpeta (la raíz del proyecto) y completa los valores. El .env nunca se sube
# al repositorio. Aquí no hay credenciales reales: los valores de Microsoft
# salen del registro de la aplicación en Entra ID (docs/entra-id-setup.md).

# --- Aplicación ---------------------------------------------------------------
# local: permite cargar los datos de demostración (nova:demo).
# production: para un servidor real (la demo queda bloqueada).
APP_ENV=local
APP_DEBUG=false
# Obligatoria. Genérala con:
#   docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Dirección por la que el navegador entra al ERP (sin barra al final).
APP_URL=http://localhost:8080
# Puerto de tu equipo donde queda publicado el ERP.
HTTP_PORT=8080

# --- Base de datos (PostgreSQL dentro de Docker) ------------------------------
DB_DATABASE=nova_sync
DB_USERNAME=nova
# Obligatoria. Usa una contraseña larga y aleatoria.
DB_PASSWORD=

# --- Sesión -------------------------------------------------------------------
# Con HTTPS (producción) pon true: la cookie solo viaja cifrada.
SESSION_SECURE_COOKIE=false
# host:puerto desde los que se abre el ERP (el mismo de APP_URL).
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# Si hay un proxy o balanceador con HTTPS delante, su IP o red (p. ej. 10.0.0.0/8).
TRUSTED_PROXIES=

# --- Microsoft 365 / Entra ID ------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Debe estar registrado EXACTAMENTE igual en Entra ID (Autenticación → URI de redirección).
MICROSOFT_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback

# --- Acceso -------------------------------------------------------------------
NOVA_AUTO_PROVISION_USERS=false
NOVA_ALLOWED_EMAIL_DOMAINS=
